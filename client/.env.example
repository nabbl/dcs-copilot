DCS_BIOS_PATH=
DCS_BIOS_MULTICAST_GROUP=239.255.50.10
DCS_BIOS_PORT=5010
DCS_BIOS_INTERFACE=127.0.0.1
DCS_BIOS_STALE_TIMEOUT=2.0

# Loopback receiver for the permission-gated MARASpatial.lua export.
DCS_SPATIAL_EXPORT_HOST=127.0.0.1
DCS_SPATIAL_EXPORT_PORT=7780
DCS_SPATIAL_EXPORT_STALE_TIMEOUT=2.0

DCS_COPILOT_CLOUD_URL=ws://127.0.0.1:8000/v2/realtime
# Use a short-lived access token returned by /v1/auth/register or /v1/auth/token.
# local-dev-token is accepted only when the local cloud dev-token escape hatch is set.
DCS_COPILOT_ACCESS_TOKEN=local-dev-token
DCS_COPILOT_DEVICE_ID=local-development-device
COPILOT_PTT_KEY=F13
# Set both values to use a Windows joystick/HOTAS button instead of the key.
COPILOT_PTT_DEVICE=
COPILOT_PTT_BUTTON=
COPILOT_MUTE_KEY=F14
# Set both values to use a Windows joystick/HOTAS button instead of the mute key.
COPILOT_MUTE_DEVICE=
COPILOT_MUTE_BUTTON=
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=20
AUDIO_QUEUE_SIZE=256
CLOUD_HANDSHAKE_TIMEOUT_SECONDS=5
CLOUD_RECONNECT_MAX_SECONDS=10

LOG_LEVEL=INFO
