# Copy this file to .env beside compose.yaml. Never commit the populated file.

# Server-side OpenAI credential. Do not put this key on the Windows client.
OPENAI_API_KEY=sk-replace-me

# Generate with: openssl rand -hex 32
DCS_COPILOT_AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes

# Use a long random URL-safe value because it is embedded in the database URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password

# Host port published by Docker Compose.
DCS_COPILOT_PORT=8000

# Optional voice model overrides.
STT_MODEL=gpt-transcribe
STT_LANGUAGE=en
LLM_MODEL=gpt-5.6
LLM_MAX_OUTPUT_TOKENS=80
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# Optional backend tuning.
CLOUD_LOG_LEVEL=info
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
