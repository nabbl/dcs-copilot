CLOUD_HOST=127.0.0.1
CLOUD_PORT=8000
MARA_DEPLOYMENT=hosted
DCS_COPILOT_DEV_TOKEN=local-dev-token
# Use PostgreSQL in production: postgresql+asyncpg://user:pass@host/database
DCS_COPILOT_DATABASE_URL=sqlite+aiosqlite:///./dcs-copilot.db
# Replace this value with at least 32 random bytes outside local development.
DCS_COPILOT_AUTH_SIGNING_KEY=local-development-signing-key-change-me
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
CLOUD_HANDSHAKE_TIMEOUT_SECONDS=5
CLOUD_MAX_UTTERANCE_SECONDS=60
CLOUD_TELEMETRY_STALE_SECONDS=30
CLOUD_LOG_LEVEL=info

# Server-side only. Never copy this file or key to the customer client.
OPENAI_API_KEY=
STT_PROVIDER=openai
STT_MODEL=gpt-transcribe
STT_LANGUAGE=en
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_MAX_OUTPUT_TOKENS=80
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
